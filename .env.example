# Open-Meteo needs no API key; these only override defaults.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
HTTP_TIMEOUT=10
OUTPUT_DIR=output
# Seed for the saved city list (JSON; Latitude/Longitude optional -> geocoded)
CITIES_FILE=data/cities.json
# TinyDB file holding the saved city list (created on first run)
CITIES_DB=db/cities.json
